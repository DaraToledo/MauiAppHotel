<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.SobrePage"
             Title="Sobre o Desenvolvedor">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F172A" Offset="0.0" />
            <GradientStop Color="#1E293B" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

            <Border BackgroundColor="White" StrokeShape="RoundRectangle 20" Padding="25">
                <VerticalStackLayout Spacing="15" HorizontalOptions="Center">

                    <Label Text="App Hotel - Reserva" FontSize="22" FontAttributes="Bold" TextColor="#1E3A8A" HorizontalOptions="Center"/>
                    <Label Text="Versão 1.0" FontSize="14" TextColor="#64748B" HorizontalOptions="Center"/>

                    <BoxView HeightRequest="1" Color="#CBD5E1" Margin="0,5"/>

                    <Label Text="Informações do Desenvolvedor:" FontAttributes="Bold" TextColor="#334155"/>

                    <Label Text="👨‍💻 Desenvolvedor: Dara Toledo" FontSize="16" TextColor="#1E293B"/>
                    <Label Text="📅 Ano de Desenvolvimento: 2026" FontSize="16" TextColor="#1E293B"/>
                    <Label Text="🏫 Curso: Desenvolvimento de Sistemas" FontSize="14" TextColor="#475569"/>

                    <Button Text="Voltar" Clicked="BtnVoltar_Clicked" BackgroundColor="#1E3A8A" TextColor="White" CornerRadius="10" Margin="0,15,0,0"/>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>